            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="yPtLGnY1rZ_X1tcXHrUH-9" value="" style="group;fontSize=6;" vertex="1" connectable="0" parent="1">
                    <mxGeometry x="1000" y="1130" width="1000" height="550" as="geometry"/>
                </mxCell>
                <mxCell id="bg" value="" style="rounded=0;fillColor=#1e1e2e;strokeColor=none;labelBackgroundColor=#000000;labelBorderColor=none;whiteSpace=wrap;html=1;fontSize=6;" parent="yPtLGnY1rZ_X1tcXHrUH-9" vertex="1">
