<mxfile host="65bd71144e" scale="2" border="0">
    <diagram id="qF72oP5cRtW77HQqX9-E" name="Page-2">
        <mxGraphModel dx="2337" dy="653" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="563" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="Te8SxzxWdNEvhooo1L9p-1" value="" style="group;fontSize=6;" vertex="1" connectable="0" parent="1">
                    <mxGeometry x="-1000" width="1000" height="560" as="geometry"/>
                </mxCell>
                <mxCell id="bg" value="" style="rounded=0;fillColor=#1e1e2e;strokeColor=none;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry width="999.9999999999998" height="560" as="geometry"/>
                </mxCell>
                <mxCell id="title" value="How a Command Reaches a Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d2038;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=6;fontStyle=1;align=center;arcSize=8;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="24.99999999999999" y="7.466666666666668" width="949.9999999999998" height="27.733333333333334" as="geometry"/>
                </mxCell>
                <mxCell id="sub" value="Pi 5 → GATT Node → BLE Mesh → Target Node → executes command → sensor data back to Pi 5" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontColor=#FFFFFF;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="24.99999999999999" y="37.33333333333334" width="949.9999999999998" height="11.733333333333334" as="geometry"/>
                </mxCell>
                <mxCell id="s1_label" value="① Pi 5 sends a command" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4f9ede;fontSize=11;fontStyle=1;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="537.5" y="74.66666666666669" width="249.99999999999994" height="12.800000000000002" as="geometry"/>
                </mxCell>
                <mxCell id="pi5" value="&lt;b style=&quot;font-size: 6px;&quot;&gt;Pi 5 Gateway&lt;/b&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;Sends a command string over BLE&lt;br style=&quot;font-size: 6px;&quot;&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;Format:  &lt;b style=&quot;font-size: 6px;&quot;&gt;NODE_ID : COMMAND : VALUE&lt;/b&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;Examples:&lt;br style=&quot;font-size: 6px;&quot;&gt;  &quot;1:DUTY:50&quot;  →  set node 1 to 50% brightness&lt;br style=&quot;font-size: 6px;&quot;&gt;  &quot;2:READ&quot;  →  read sensor data from node 2&lt;br style=&quot;font-size: 6px;&quot;&gt;  &quot;ALL:RAMP&quot;  →  ramp test on every node&lt;br style=&quot;font-size: 6px;&quot;&gt;  &quot;1:STOP&quot;  →  turn node 1 off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=6;arcSize=15;align=center;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="268.75" y="64.00000000000001" width="249.99999999999994" height="82.66666666666669" as="geometry"/>
                </mxCell>
                <mxCell id="s2_label" value="② The GATT Node receives it" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4f9ede;fontSize=11;fontStyle=1;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="537.5" y="176.00000000000003" width="249.99999999999994" height="12.800000000000002" as="geometry"/>
                </mxCell>
                <mxCell id="gatt_node" value="&lt;b style=&quot;font-size: 6px;&quot;&gt;GATT Node  (the BLE bridge)&lt;/b&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;Receives the command and parses it.&lt;br style=&quot;font-size: 6px;&quot;&gt;Decides where to send it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=6;arcSize=15;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="268.75" y="176.00000000000003" width="249.99999999999994" height="38.4" as="geometry"/>
                </mxCell>
                <mxCell id="e_pi_gatt" value="BLE GATT write" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4f9ede;fontColor=#FFFFFF;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#000000;" parent="Te8SxzxWdNEvhooo1L9p-1" source="pi5" target="gatt_node" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="gatt_flex" value="&lt;b style=&quot;font-size: 6px;&quot;&gt;🔄 Any node can be the GATT Node&lt;/b&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;All nodes run identical firmware.&lt;br style=&quot;font-size: 6px;&quot;&gt;If this node loses power, Pi 5&lt;br style=&quot;font-size: 6px;&quot;&gt;reconnects to another node automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1040;strokeColor=#9c6fde;fontColor=#ddbbff;fontSize=6;arcSize=12;align=left;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="737.4999999999998" y="176.00000000000003" width="162.49999999999994" height="42.66666666666667" as="geometry"/>
                </mxCell>
                <mxCell id="s3_label" value="③ Where does the command go?" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#f0a500;fontSize=11;fontStyle=1;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="71.875" y="218.66666666666669" width="146.87499999999994" height="12.800000000000002" as="geometry"/>
                </mxCell>
                <mxCell id="case_a_bg" value="" style="rounded=1;fillColor=#1a2a0a;strokeColor=#4caf50;arcSize=10;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="62.499999999999986" y="266.66666666666674" width="199.99999999999991" height="58.66666666666667" as="geometry"/>
                </mxCell>
                <mxCell id="case_a_t" value="CASE A — Targeting this node" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4caf50;fontSize=6;fontStyle=1;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="71.875" y="270.9333333333334" width="181.24999999999994" height="10.666666666666668" as="geometry"/>
                </mxCell>
                <mxCell id="case_a" value="Command is for the GATT node itself.&lt;br style=&quot;font-size: 6px;&quot;&gt;Runs locally — no mesh hop needed.&lt;br style=&quot;font-size: 6px;&quot;&gt;Reply goes straight back to Pi 5." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#ccffcc;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="71.875" y="281.6000000000001" width="181.24999999999994" height="38.4" as="geometry"/>
                </mxCell>
                <mxCell id="case_b_bg" value="" style="rounded=1;fillColor=#1a1a3a;strokeColor=#e05c5c;arcSize=10;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="293.7499999999999" y="266.66666666666674" width="199.99999999999991" height="58.66666666666667" as="geometry"/>
                </mxCell>
                <mxCell id="case_b_t" value="CASE B — Targeting a single node" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#e05c5c;fontSize=6;fontStyle=1;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="303.1249999999999" y="270.9333333333334" width="181.24999999999994" height="10.666666666666668" as="geometry"/>
                </mxCell>
                <mxCell id="case_b" value="Command sent over BLE Mesh to that&lt;br style=&quot;font-size: 6px;&quot;&gt;specific node's unicast address.&lt;br style=&quot;font-size: 6px;&quot;&gt;That node runs it and replies via mesh." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#ffcccc;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="303.1249999999999" y="282.6666666666667" width="181.24999999999994" height="38.4" as="geometry"/>
                </mxCell>
                <mxCell id="case_c_bg" value="" style="rounded=1;fillColor=#2a1a0a;strokeColor=#f0a500;arcSize=10;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="518.7499999999999" y="266.66666666666674" width="212.4999999999999" height="58.66666666666667" as="geometry"/>
                </mxCell>
                <mxCell id="case_c_t" value="CASE C — Targeting ALL nodes" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#f0a500;fontSize=6;fontStyle=1;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="528.125" y="270.9333333333334" width="193.74999999999991" height="10.666666666666668" as="geometry"/>
                </mxCell>
                <mxCell id="case_c" value="GATT node runs command locally first,&lt;br style=&quot;font-size: 6px;&quot;&gt;then broadcasts to group 0xC000.&lt;br style=&quot;font-size: 6px;&quot;&gt;All other nodes run it too." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#ffdda0;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="528.125" y="282.6666666666667" width="193.74999999999991" height="38.4" as="geometry"/>
                </mxCell>
                <mxCell id="e_ga" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" source="gatt_node" target="case_a_bg" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s4_label" value="④ The node executes the command" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4caf50;fontSize=11;fontStyle=1;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="284.375" y="330.66666666666674" width="312.4999999999999" height="12.800000000000002" as="geometry"/>
                </mxCell>
                <mxCell id="cmd_read" value="&lt;b style=&quot;font-size: 6px;&quot;&gt;READ&lt;/b&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;No change to load.&lt;br style=&quot;font-size: 6px;&quot;&gt;Returns: voltage, current,&lt;br style=&quot;font-size: 6px;&quot;&gt;power, duty %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=6;arcSize=15;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="62.499999999999986" y="357.33333333333337" width="118.74999999999997" height="46.93333333333334" as="geometry"/>
                </mxCell>
                <mxCell id="cmd_duty" value="&lt;b style=&quot;font-size: 6px;&quot;&gt;DUTY:50  or just  50&lt;/b&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;Sets PWM to 50%.&lt;br style=&quot;font-size: 6px;&quot;&gt;Returns sensor reading&lt;br style=&quot;font-size: 6px;&quot;&gt;at the new level." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=6;arcSize=15;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="190.62499999999994" y="357.33333333333337" width="118.74999999999997" height="46.93333333333334" as="geometry"/>
                </mxCell>
                <mxCell id="cmd_stop" value="&lt;b style=&quot;font-size: 6px;&quot;&gt;STOP  /  0&lt;/b&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;Turns load fully OFF.&lt;br style=&quot;font-size: 6px;&quot;&gt;Returns sensor reading&lt;br style=&quot;font-size: 6px;&quot;&gt;(should read 0 A)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#e05c5c;fontColor=#ffcccc;fontSize=6;arcSize=15;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="318.7499999999999" y="357.33333333333337" width="118.74999999999997" height="46.93333333333334" as="geometry"/>
                </mxCell>
                <mxCell id="cmd_on" value="&lt;b style=&quot;font-size: 6px;&quot;&gt;100  /  ON&lt;/b&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;Turns load fully ON.&lt;br style=&quot;font-size: 6px;&quot;&gt;Returns sensor reading&lt;br style=&quot;font-size: 6px;&quot;&gt;at full brightness." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=6;arcSize=15;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="446.8749999999998" y="357.33333333333337" width="118.74999999999997" height="46.93333333333334" as="geometry"/>
                </mxCell>
                <mxCell id="cmd_ramp" value="&lt;b style=&quot;font-size: 6px;&quot;&gt;RAMP&lt;/b&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;Steps through duty levels:&lt;br style=&quot;font-size: 6px;&quot;&gt;0% → 25% → 50% → 75% → 100%&lt;br style=&quot;font-size: 6px;&quot;&gt;(500 ms each), then resets to 0%.&lt;br style=&quot;font-size: 6px;&quot;&gt;Returns final sensor reading." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a3a;strokeColor=#9c6fde;fontColor=#ddbbff;fontSize=6;arcSize=15;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="575" y="357.33333333333337" width="149.99999999999994" height="46.93333333333334" as="geometry"/>
                </mxCell>
                <mxCell id="s5_label" value="⑤ Sensor data returns to Pi 5" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4f9ede;fontSize=11;fontStyle=1;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="631.2499999999998" y="481.0666666666667" width="312.4999999999999" height="12.800000000000002" as="geometry"/>
                </mxCell>
                <mxCell id="resp" value="&lt;b style=&quot;font-size: 6px;&quot;&gt;Response format:&lt;/b&gt;  NODE1:DATA:D:50%,V:12.003V,I:500.00mA,P:6001.5mW&lt;br style=&quot;font-size: 6px;&quot;&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;Target node sends data back over BLE Mesh → GATT node receives → forwards to Pi 5 via BLE GATT notify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=6;arcSize=12;align=left;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="140.625" y="468.2666666666667" width="474.9999999999999" height="38.4" as="geometry"/>
                </mxCell>
                <mxCell id="e_r1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" source="cmd_read" target="resp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_r2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" source="cmd_duty" target="resp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_r3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e05c5c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" source="cmd_stop" target="resp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_r4" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" source="cmd_on" target="resp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_r5" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9c6fde;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" source="cmd_ramp" target="resp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_back" value="back to Pi 5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4f9ede;fontColor=#FFFFFF;fontSize=9;exitX=0;exitY=0.5;exitDx=0;exitDy=0;labelBackgroundColor=#000000;" parent="Te8SxzxWdNEvhooo1L9p-1" source="resp" target="pi5" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="31.249999999999993" y="487.4666666666667"/>
                            <mxPoint x="31.249999999999993" y="112.00000000000001"/>
                        </Array>
                        <mxPoint x="124.99999999999997" y="112.00000000000001" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="chunk_note" value="&lt;b style=&quot;font-size: 6px;&quot;&gt;📦 Long responses are chunked&lt;/b&gt;&lt;br style=&quot;font-size: 6px;&quot;&gt;If the response is &amp;gt;20 bytes,&lt;br style=&quot;font-size: 6px;&quot;&gt;it's split into pieces. Pi 5&lt;br style=&quot;font-size: 6px;&quot;&gt;reassembles them automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d1a2e;strokeColor=#4f9ede;fontColor=#aaaaee;fontSize=6;arcSize=12;align=left;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
                    <mxGeometry x="749.9999999999998" y="354.1333333333334" width="168.74999999999994" height="46.93333333333334" as="geometry"/>
