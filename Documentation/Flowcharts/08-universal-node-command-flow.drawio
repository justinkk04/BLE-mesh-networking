                <mxCell id="l3" value="Node executes — OFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#e05c5c;fontColor=#ffcccc;fontSize=6;" parent="Te8SxzxWdNEvhooo1L9p-1" vertex="1">
