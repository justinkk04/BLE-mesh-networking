                </mxCell>
                <mxCell id="e_pri_no" value="No" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9c6fde;fontColor=#ffffff;fontSize=9;exitX=0;exitY=0.5;entryX=0.5;entryY=0;labelBackgroundColor=#000000;" parent="1" source="pri_d" target="bal_equal" edge="1">
                    <mxGeometry x="0.35" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bal_pri" value="&lt;b&gt;Branch B — Priority-Weighted Distribution&lt;/b&gt;&lt;br&gt;&lt;i&gt;Priority node receives 2× the standard share&lt;/i&gt;&lt;br&gt;&lt;br&gt;Total Shares = 2 + (N − 1)&lt;br&gt;Priority budget = 2 / Total × Budget&lt;br&gt;Others split the remaining budget equally&lt;br&gt;Surplus from ceiling is redistributed&lt;br&gt;&lt;br&gt;→ Adjust each node's duty cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a0a30;strokeColor=#9c6fde;fontColor=#ddbbff;fontSize=10;arcSize=10;" parent="1" vertex="1">
