                <mxCell id="c4h" value="&lt;font color=&quot;#9933ff&quot;&gt;④ BALANCING — Distribution Strategy&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#e05c5c;fontSize=13;fontStyle=1;" parent="1" vertex="1">
