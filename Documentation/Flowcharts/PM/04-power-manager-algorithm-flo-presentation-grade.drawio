                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bal_equal" value="&lt;b&gt;Branch A — Equal Share Distribution&lt;/b&gt;&lt;br&gt;&lt;i&gt;No priority node configured&lt;/i&gt;&lt;br&gt;&lt;br&gt;Power Share per Node = Budget ÷ N&lt;br&gt;Every online node receives equal allocation&lt;br&gt;&lt;br&gt;→ Adjust each node's duty cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a0a30;strokeColor=#9c6fde;fontColor=#ddbbff;fontSize=10;arcSize=10;" parent="1" vertex="1">
