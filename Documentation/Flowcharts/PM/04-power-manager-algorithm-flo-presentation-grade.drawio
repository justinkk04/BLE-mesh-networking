                <mxCell id="dir_box" value="&lt;b&gt;Determine Adjustment Direction&lt;/b&gt;&lt;br&gt;Total draw &lt; Budget → ▲ Increase Node Load&lt;br&gt;Total draw ≥ Budget → ▼ Reduce Node Load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=10;arcSize=12;" parent="1" vertex="1">
