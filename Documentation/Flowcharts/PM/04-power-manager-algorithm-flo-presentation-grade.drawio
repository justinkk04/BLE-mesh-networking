                <mxCell id="pri_d" value="&lt;b&gt;Priority node&lt;br&gt;configured?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3a2200;strokeColor=#f0a500;fontColor=#f0de00;fontSize=10;fontStyle=1;" parent="1" vertex="1">
