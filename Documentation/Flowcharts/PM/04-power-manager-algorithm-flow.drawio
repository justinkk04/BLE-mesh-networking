                <mxCell id="const_body" value="&lt;table style=&quot;font-size:9px;color:#ccc;border-collapse:collapse;width:100%&quot;&gt;&lt;tbody&gt;&lt;tr style=&quot;border-bottom:1px solid #333&quot;&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;POLL_INTERVAL&lt;/b&gt;&lt;/td&gt;&lt;td&gt;3.0 s&lt;/td&gt;&lt;td&gt;Gap between poll cycles&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #333&quot;&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;READ_STAGGER&lt;/b&gt;&lt;/td&gt;&lt;td&gt;2.5 s&lt;/td&gt;&lt;td&gt;Gap between sequential READs&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #333&quot;&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;STALE_TIMEOUT&lt;/b&gt;&lt;/td&gt;&lt;td&gt;45.0 s&lt;/td&gt;&lt;td&gt;Mark node unresponsive&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #333&quot;&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;COOLDOWN&lt;/b&gt;&lt;/td&gt;&lt;td&gt;5.0 s&lt;/td&gt;&lt;td&gt;Min time between adjustments&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #333&quot;&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;HEADROOM_MW&lt;/b&gt;&lt;/td&gt;&lt;td&gt;500 mW&amp;nbsp;&amp;nbsp;&lt;/td&gt;&lt;td&gt;Buffer below threshold&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;&lt;b&gt;PRIORITY_WEIGHT&lt;/b&gt;&lt;/td&gt;&lt;td&gt;2.0&lt;/td&gt;&lt;td&gt;Priority node gets 2× share&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#cccccc;fontSize=9;verticalAlign=top;" parent="1" vertex="1">
