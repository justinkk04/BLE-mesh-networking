                <mxCell id="e_g1s" value="Yes" style="edgeStyle=none;strokeColor=#e05c5c;fontColor=#ffffff;fontSize=9;exitX=0;exitY=0.5;entryX=1;entryY=0.05;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="g1" target="skip_rail" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_g3s" value="No" style="edgeStyle=none;strokeColor=#e05c5c;fontColor=#ffffff;fontSize=9;exitX=0;exitY=0.5;entryX=1;entryY=0.30;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="g3" target="skip_rail" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_g4s" value="None" style="edgeStyle=none;strokeColor=#e05c5c;fontColor=#ffffff;fontSize=9;exitX=0;exitY=0.5;entryX=1;entryY=0.45;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="g4" target="skip_rail" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_g5s" value="No" style="edgeStyle=none;strokeColor=#e05c5c;fontColor=#ffffff;fontSize=9;exitX=0;exitY=0.5;entryX=1;entryY=0.60;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="g5" target="skip_rail" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_g6s" value="Yes (deadband)" style="edgeStyle=none;strokeColor=#e05c5c;fontColor=#ffffff;fontSize=9;exitX=0;exitY=0.5;entryX=1;entryY=0.78;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="g6" target="skip_rail" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_g7s" value="Yes (optimal)" style="edgeStyle=none;strokeColor=#e05c5c;fontColor=#ffffff;fontSize=9;exitX=0;exitY=0.5;entryX=1;entryY=0.95;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="g7" target="skip_rail" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g2_yes_note" value="&lt;b&gt;Yes&lt;/b&gt; → bypass cooldown,&lt;br&gt;reset commanded_duty from sensor,&lt;br&gt;skip g3 + g6 + g7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1a00;strokeColor=#f0a500;fontColor=#ffdda0;fontSize=9;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="225" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_g2yn" value="Yes" style="edgeStyle=none;strokeColor=#f0a500;fontColor=#ffffff;fontSize=9;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="g2" target="g2_yes_note" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_d" value="④ BALANCING" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#e05c5c;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="85" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pri_d" value="&lt;b&gt;Priority node set?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3a2200;strokeColor=#f0a500;fontColor=#ffffff;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="660" width="220" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="e_dirpri" value="proceed" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;fontColor=#ffffff;fontSize=9;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="dir_box" target="pri_d" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="branch_a_hdr" value="Branch A — No priority (equal shares)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#9c6fde;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="110" width="320" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="ba_box" value="&lt;b&gt;_balance_proportional(nodes, budget)&lt;/b&gt;&lt;br&gt;&lt;br&gt;share_mw = budget / N&lt;br&gt;for each node: _nudge_node()&lt;br&gt;&lt;br&gt;Log: &quot;Balancing X/YmW (share: ZmW each)&lt;br&gt;— N1:40→55%, N2:40→55%&quot;&lt;br&gt;&lt;br&gt;Broadcast pm_update → WebSocket → Web UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#e05c5c;fontColor=#ffcccc;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="770" y="855" width="320" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="branch_b_hdr" value="Branch B — Priority node set" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#9c6fde;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="305" width="320" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="bb_box" value="&lt;b&gt;_balance_with_priority(nodes, budget)&lt;/b&gt;&lt;br&gt;&lt;br&gt;total_shares = PRIORITY_WEIGHT + (N − 1)&lt;br&gt;            = 2 + (N − 1)&lt;br&gt;&lt;br&gt;priority_budget = budget × (2 / total_shares)&lt;br&gt;non_pri_share  = remaining / (N − 1)&lt;br&gt;&lt;br&gt;&lt;b&gt;Ceiling check:&lt;/b&gt; if priority's target_duty&lt;br&gt;limits it below its share, surplus is&lt;br&gt;redistributed to non-priority nodes.&lt;br&gt;&lt;br&gt;Nudge priority first, then others.&lt;br&gt;Log:  pri:AmW, others:BmW each&lt;br&gt;Broadcast pm_update → WebSocket → Web UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#e05c5c;fontColor=#ffcccc;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="310" width="320" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="e_priA" value="No" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e05c5c;fontColor=#ffffff;fontSize=9;exitX=0.25;exitY=0;entryX=0.25;entryY=1;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="pri_d" target="ba_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_priB" value="Yes" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e05c5c;fontColor=#ffffff;fontSize=9;exitX=0.75;exitY=0;entryX=0.75;entryY=1;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="pri_d" target="bb_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="last_adj" value="&lt;b&gt;_last_adjustment = now&lt;/b&gt;     _adjusting = False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=10;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="740" width="320" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="e_priLA" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4f9ede;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="pri_d" target="last_adj" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="const_bg" value="" style="rounded=1;fillColor=#141424;strokeColor=#333355;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="85" width="450" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="const_title" value="KEY CONSTANTS" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontColor=#888888;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="90" width="450" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="const_body" value="&lt;table style='font-size:10px;color:#cccccc;border-collapse:collapse;width:100%'&gt;&lt;tr style='border-bottom:1px solid #333'&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;POLL_INTERVAL&lt;/b&gt;&lt;/td&gt;&lt;td&gt;3.0 s&lt;/td&gt;&lt;td&gt;Gap between poll cycles&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #333'&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;HEADROOM_MW&lt;/b&gt;&lt;/td&gt;&lt;td&gt;500 mW&lt;/td&gt;&lt;td&gt;budget = threshold − headroom&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #333'&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;STALE_TIMEOUT&lt;/b&gt;&lt;/td&gt;&lt;td&gt;45 s&lt;/td&gt;&lt;td&gt;Mark node unresponsive&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #333'&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;COOLDOWN&lt;/b&gt;&lt;/td&gt;&lt;td&gt;5.0 s&lt;/td&gt;&lt;td&gt;Min between adjustments&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #333'&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;PRIORITY_WEIGHT&lt;/b&gt;&lt;/td&gt;&lt;td&gt;2.0×&lt;/td&gt;&lt;td&gt;Priority node’s share factor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;Dead band&lt;/b&gt;&lt;/td&gt;&lt;td&gt;±5 %&lt;/td&gt;&lt;td&gt;Skip nudge inside this band&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#cccccc;fontSize=10;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="112" width="430" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_e" value="⑤ NUDGE NODE — _nudge_node(nid, ns, share, all)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#e05c5c;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="290" width="450" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="&lt;b&gt;1.  Estimate mW per duty %&lt;/b&gt;&lt;br&gt;mw_per_pct = ns.power / ns.commanded_duty&lt;br&gt;If no data → average from peers (last resort 50 mW/%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#e05c5c;fontColor=#ffcccc;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="315" width="450" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;b&gt;2.  ideal_duty = target_share_mw / mw_per_pct&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#e05c5c;fontColor=#ffcccc;fontSize=10;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="385" width="450" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;b&gt;3.  Clamp to [0, target_duty]&lt;/b&gt;&lt;br&gt;Never exceed user’s ceiling — PM may only LOWER duty." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#e05c5c;fontColor=#ffcccc;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="427" width="450" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;b&gt;4.  new_duty == current commanded?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3a2200;strokeColor=#f0a500;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1480" y="487" width="310" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="n4_noop" value="No-op&lt;br&gt;return None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141424;strokeColor=#333355;fontColor=#888888;fontSize=10;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1800" y="495" width="60" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="&lt;b&gt;5.  Send DUTY:XX command via mesh&lt;/b&gt;&lt;br&gt;await gateway.set_duty(nid, new_duty)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#e05c5c;fontColor=#ffcccc;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="555" width="450" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="&lt;b&gt;6.  Wait for node response (best effort)&lt;/b&gt;&lt;br&gt;next poll self-corrects if the command was lost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#e05c5c;fontColor=#ffcccc;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="613" width="450" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="&lt;b&gt;7.  ns.commanded_duty = new_duty&lt;/b&gt;&lt;br&gt;return change description e.g. ‘N1:50→35%’" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="671" width="450" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="e_n1n2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e05c5c;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="n1" target="n2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_n2n3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e05c5c;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="n2" target="n3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_n3n4" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e05c5c;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="n3" target="n4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_n4noop" value="Yes" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#888888;fontColor=#ffffff;fontSize=9;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="n4" target="n4_noop" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_n4n5" value="No" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e05c5c;fontColor=#ffffff;fontSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="n4" target="n5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_n5n6" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e05c5c;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="n5" target="n6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_n6n7" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="n6" target="n7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="nudge_note" value="&lt;b&gt;Why commanded_duty (not sensor_duty)?&lt;/b&gt;&lt;br&gt;Sensor data lags PM commands by one mesh round-trip.&lt;br&gt;Using sensor_duty in the mW/% estimate would feed&lt;br&gt;stale values back into the controller and oscillate.&lt;br&gt;commanded_duty = ‘what PM last sent’ — always fresh." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1040;strokeColor=#9c6fde;fontColor=#ddbbff;fontSize=10;arcSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="730" width="450" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_state" value="⑥ NODE STATE (per node)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4f9ede;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="820" width="450" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="state_bg" value="" style="rounded=1;fillColor=#1a3a5c;strokeColor=#4f9ede;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="845" width="450" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="state_body" value="&lt;table style='font-size:10px;color:#ffffff;border-collapse:collapse;width:100%'&gt;&lt;tr style='border-bottom:1px solid #4f9ede'&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;duty&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Last sensor-reported duty %&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #4f9ede'&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;commanded_duty&lt;/b&gt;&lt;/td&gt;&lt;td&gt;What PM last sent&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #4f9ede'&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;target_duty&lt;/b&gt;&lt;/td&gt;&lt;td&gt;User’s original setting (the ceiling)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #4f9ede'&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;voltage / current / power&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Last reported telemetry&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #4f9ede'&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;responsive&lt;/b&gt;&lt;/td&gt;&lt;td&gt;True / False (set False after STALE_TIMEOUT)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-bottom:1px solid #4f9ede'&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;last_seen&lt;/b&gt;&lt;/td&gt;&lt;td&gt;monotonic timestamp of last reply&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px'&gt;&lt;b&gt;poll_gen&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Generation of last poll that got a reply&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#ffffff;fontSize=10;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="855" width="430" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="e_p6_g1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f0a500;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;dashed=1;" parent="1" source="p6_eval" target="entry_eval" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="leg_bg" value="" style="rounded=1;fillColor=#141424;strokeColor=#333355;arcSize=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1080" width="1820" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="leg_t" value="COLOUR LEGEND" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#aaaaaa;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="55" y="1088" width="200" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="lg1" value="User actions / gateway layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=10;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="55" y="1115" width="280" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lg2" value="Poll cycle / sensor data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=10;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="350" y="1115" width="280" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lg3" value="Decision diamonds / thresholds" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3a2200;strokeColor=#f0a500;fontColor=#ffffff;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="645" y="1115" width="280" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lg4" value="Duty commands sent to nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#e05c5c;fontColor=#ffcccc;fontSize=10;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="940" y="1115" width="280" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lg5" value="Balance outcomes / annotations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1040;strokeColor=#9c6fde;fontColor=#ddbbff;fontSize=10;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1235" y="1115" width="280" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lg6" value="Forced eval / warning notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1a00;strokeColor=#f0a500;fontColor=#ffdda0;fontSize=10;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1530" y="1115" width="280" height="50" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>