                <mxCell id="g4" value="&lt;b&gt;Any responsive nodes?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3a2200;strokeColor=#f0a500;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="760" y="370" width="240" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="g5" value="&lt;b&gt;budget &gt; 0?&lt;/b&gt;&lt;br&gt;(threshold high enough)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3a2200;strokeColor=#f0a500;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="760" y="440" width="240" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="g6" value="&lt;b&gt;|total − budget|&lt;br&gt;&lt; 5 % of budget?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3a2200;strokeColor=#f0a500;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="760" y="510" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="g7" value="&lt;b&gt;All at ceiling AND in sync&lt;br&gt;AND under budget?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3a2200;strokeColor=#f0a500;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="760" y="585" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="dir_box" value="&lt;b&gt;Direction:&lt;/b&gt;     total &lt; budget → ▲ UP&lt;br&gt;total ≥ budget → ▼ DOWN&lt;br&gt;set _adjusting = True, proceed →" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=10;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="740" y="660" width="300" height="55" as="geometry"/>
