                <mxCell id="e_p2p3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="p2_send" target="p3_wait" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
