                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_p4p5" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="p4_stale" target="p5_breathe" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_p5p6" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f0a500;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="p5_breathe" target="p6_eval" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_p6p7" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="p6_eval" target="p7_sleep" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_loop" value="loop" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;fontColor=#ffffff;fontSize=9;exitX=0;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;labelBackgroundColor=#000000;" parent="1" source="p7_sleep" target="p2_send" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="370" y="466"/>
                            <mxPoint x="370" y="184"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="web_pause" value="&lt;b&gt;Web auto-poll PAUSED&lt;/b&gt; while PM is active.&lt;br&gt;PM does the polling instead — restored on disable()." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1040;strokeColor=#9c6fde;fontColor=#ddbbff;fontSize=9;arcSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="390" y="495" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_resp" value="⑦ RESPONSE PATH" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4caf50;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="390" y="565" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="resp_box" value="&lt;b&gt;Node sensor reply&lt;/b&gt;&lt;br&gt;D:X% , V:Xv , I:XmA , P:XmW&lt;br&gt;&lt;br&gt;↓  via BLE Mesh (subnet 0)&lt;br&gt;&lt;br&gt;&lt;b&gt;GATT node&lt;/b&gt; receives, forwards via GATT notify&lt;br&gt;&lt;br&gt;↓  BLE GATT notification to Pi 5&lt;br&gt;&lt;br&gt;&lt;b&gt;on_sensor_data()&lt;/b&gt; updates NodeState&lt;br&gt;PM reads it next _evaluate_and_adjust()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="390" y="590" width="320" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_gatt" value="GATT FAILOVER" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#9c6fde;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="390" y="785" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gatt_note" value="If the GATT node loses power, Pi 5 reconnects&lt;br&gt;to another mesh node automatically.&lt;br&gt;During reconnect: &lt;b&gt;_paused = True&lt;/b&gt; — poll loop&lt;br&gt;sleeps 1 s and skips evaluation. Resumes&lt;br&gt;cleanly once a new GATT node is connected." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1040;strokeColor=#9c6fde;fontColor=#ddbbff;fontSize=10;arcSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="390" y="810" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_c" value="③ EQUILIBRIUM DECISION" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#f0a500;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="730" y="85" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="entry_eval" value="&lt;b&gt;_evaluate_and_adjust()&lt;/b&gt; runs every poll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1a00;strokeColor=#f0a500;fontColor=#ffdda0;fontSize=10;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="740" y="110" width="300" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="g1" value="&lt;b&gt;PM disabled OR&lt;br&gt;already adjusting?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3a2200;strokeColor=#f0a500;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="760" y="160" width="240" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="g2" value="&lt;b&gt;Forced eval?&lt;/b&gt;&lt;br&gt;(_force_evaluate)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3a2200;strokeColor=#f0a500;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="760" y="230" width="240" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="g3" value="&lt;b&gt;Cooldown elapsed?&lt;/b&gt;&lt;br&gt;(≥ 5 s since last adj)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3a2200;strokeColor=#f0a500;fontColor=#ffffff;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="760" y="300" width="240" height="55" as="geometry"/>
