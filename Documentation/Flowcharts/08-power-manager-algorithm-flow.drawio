    <diagram id="pm08" name="Power Manager Lifecycle">
        <mxGraphModel dx="2634" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
