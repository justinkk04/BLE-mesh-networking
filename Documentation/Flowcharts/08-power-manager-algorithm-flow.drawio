                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="bg" value="" style="rounded=0;fillColor=#1e1e2e;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry width="1900" height="1200" as="geometry"/>
                </mxCell>
                <mxCell id="title" value="Power Manager — Equilibrium Lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d2038;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=16;fontStyle=1;align=center;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="15" width="1820" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Threshold activation → poll cycle → equilibrium decision → priority-weighted balancing → nudge commands         (gateway-pi5/gateway-code/power_manager.py)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontColor=#aaaaaa;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="53" width="1820" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_a" value="① USER ENABLES POWER MANAGER" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4f9ede;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="50" y="85" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="u1_set" value="&lt;b&gt;User sets threshold&lt;/b&gt;&lt;br&gt;TUI ‘pm 6000’ or web API&lt;br&gt;&lt;br&gt;threshold = 6000 mW&lt;br&gt;budget = threshold − HEADROOM&lt;br&gt;        = 6000 − 500 = &lt;b&gt;5500 mW&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="110" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="u2_boot" value="&lt;b&gt;Bootstrap discovery&lt;/b&gt; (first enable)&lt;br&gt;&lt;br&gt;Probe addresses 1..N from BLE scan.&lt;br&gt;Send READ → register responding nodes.&lt;br&gt;Skipped if nodes already known." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="225" width="320" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="u3_ceiling" value="&lt;b&gt;target_duty = current sensor duty&lt;/b&gt;&lt;br&gt;Frozen on FIRST enable only.&lt;br&gt;PM may only LOWER duty from here —&lt;br&gt;target_duty becomes the user's ceiling." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1040;strokeColor=#9c6fde;fontColor=#ddbbff;fontSize=10;arcSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="330" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="e_u1_u2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4f9ede;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="u1_set" target="u2_boot" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_u2_u3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9c6fde;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="u2_boot" target="u3_ceiling" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_disable" value="⑥ DISABLE POWER MANAGER" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4f9ede;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="50" y="425" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="&lt;b&gt;threshold_mw = None&lt;/b&gt;     _polling = False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=9;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="50" y="450" width="320" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="&lt;b&gt;Sleep 2s&lt;/b&gt; — let in-flight mesh commands finish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=9;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="50" y="490" width="320" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="d3" value="&lt;b&gt;Restore each node:&lt;/b&gt;  commanded_duty → target_duty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=9;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="50" y="530" width="320" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="d4" value="&lt;b&gt;Resume web auto-poll&lt;/b&gt; (if user had it enabled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=9;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="50" y="570" width="320" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="e_d1d2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4f9ede;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="d1" target="d2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_d2d3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4f9ede;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="d2" target="d3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_d3d4" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="d3" target="d4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_forced" value="⚠  FORCED RE-EVALUATION" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#f0a500;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="50" y="620" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="forced_note" value="Setting threshold or priority sets&lt;br&gt;&lt;b&gt;_force_evaluate = True&lt;/b&gt; — bypasses cooldown&lt;br&gt;and dead band on the next eval cycle.&lt;br&gt;&lt;br&gt;Also resets &lt;b&gt;commanded_duty&lt;/b&gt; from actual&lt;br&gt;sensor data so the mW/% estimate doesn't&lt;br&gt;use stale values from before the change." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1a00;strokeColor=#f0a500;fontColor=#ffdda0;fontSize=10;arcSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="645" width="320" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_b" value="② POLL CYCLE — fires every 3 s" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4caf50;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="390" y="85" width="320" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p1_wake" value="&lt;b&gt;poll_loop()&lt;/b&gt; wakes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=10;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="390" y="110" width="320" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p2_send" value="&lt;b&gt;_poll_all_nodes()&lt;/b&gt;&lt;br&gt;Send ALL:READ → BLE Mesh group 0xC000.&lt;br&gt;Each node replies individually." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="390" y="155" width="320" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="p3_wait" value="&lt;b&gt;_wait_for_responses(timeout = 4 s)&lt;/b&gt;&lt;br&gt;Wait until every responsive node has&lt;br&gt;reported for this poll generation, or timeout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="390" y="225" width="320" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="p4_stale" value="&lt;b&gt;_mark_stale_nodes()&lt;/b&gt;&lt;br&gt;Any node not seen in &lt;b&gt;45 s&lt;/b&gt; → responsive = False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=10;arcSize=12;align=left;" parent="1" vertex="1">
                    <mxGeometry x="390" y="295" width="320" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="p5_breathe" value="&lt;b&gt;Sleep 1.0 s&lt;/b&gt; — relay breathing gap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=10;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="390" y="355" width="320" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p6_eval" value="&lt;b&gt;_evaluate_and_adjust()&lt;/b&gt;     →" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1a00;strokeColor=#f0a500;fontColor=#ffdda0;fontSize=11;fontStyle=1;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="390" y="400" width="320" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="p7_sleep" value="&lt;b&gt;Sleep POLL_INTERVAL (3 s)&lt;/b&gt; → loop ↑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=10;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="390" y="450" width="320" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="e_p1p2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" parent="1" source="p1_wake" target="p2_send" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
