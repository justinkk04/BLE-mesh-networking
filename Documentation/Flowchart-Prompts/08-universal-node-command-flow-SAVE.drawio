    <diagram id="qF72oP5cRtW77HQqX9-E" name="Page-1">
        <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <!-- BACKGROUND -->
                <mxCell id="bg" value="" style="rounded=0;fillColor=#1e1e2e;strokeColor=none;" vertex="1" parent="1">
                    <mxGeometry x="0" y="0" width="1600" height="1050" as="geometry"/>
                </mxCell>
                <!-- TITLE -->
                <mxCell id="title" value="How a Command Reaches a Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d2038;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=22;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1">
                    <mxGeometry x="40" y="14" width="1520" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="sub" value="Pi 5 → GATT Node → BLE Mesh → Target Node → executes command → sensor data back to Pi 5" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontColor=#666699;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="40" y="70" width="1520" height="22" as="geometry"/>
                </mxCell>
                <!-- ============================= -->
                <!-- STEP 1: Pi 5 sends a command  -->
                <!-- ============================= -->
                <mxCell id="s1_label" value="① Pi 5 sends a command" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4f9ede;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="200" y="102" width="400" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pi5" value="&lt;b&gt;Pi 5 Gateway&lt;/b&gt;&lt;br&gt;Sends a command string over BLE&lt;br&gt;&lt;br&gt;Format:  &lt;b&gt;NODE_ID : COMMAND : VALUE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Examples:&lt;br&gt;  &amp;quot;1:DUTY:50&amp;quot;  →  set node 1 to 50% brightness&lt;br&gt;  &amp;quot;2:READ&amp;quot;  →  read sensor data from node 2&lt;br&gt;  &amp;quot;ALL:RAMP&amp;quot;  →  ramp test on every node&lt;br&gt;  &amp;quot;1:STOP&amp;quot;  →  turn node 1 off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=12;arcSize=15;align=left;" vertex="1" parent="1">
                    <mxGeometry x="200" y="130" width="400" height="155" as="geometry"/>
                </mxCell>
                <!-- ============================================= -->
                <!-- STEP 2: GATT node receives it                 -->
                <!-- ============================================= -->
                <mxCell id="s2_label" value="② The GATT Node receives it" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4f9ede;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="200" y="300" width="400" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="gatt_node" value="&lt;b&gt;GATT Node  (the BLE bridge)&lt;/b&gt;&lt;br&gt;Receives the command and parses it.&lt;br&gt;Decides where to send it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=12;arcSize=15;" vertex="1" parent="1">
                    <mxGeometry x="200" y="328" width="400" height="72" as="geometry"/>
                </mxCell>
                <!-- Arrow: Pi 5 → GATT node -->
                <mxCell id="e_pi_gatt" value="BLE GATT write" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4f9ede;fontColor=#aaaaaa;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="pi5" target="gatt_node" parent="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- GATT flexible note -->
                <mxCell id="gatt_flex" value="&lt;b&gt;🔄 Any node can be the GATT Node&lt;/b&gt;&lt;br&gt;All nodes run identical firmware.&lt;br&gt;If this node loses power, Pi 5&lt;br&gt;reconnects to another node automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1040;strokeColor=#9c6fde;fontColor=#ddbbff;fontSize=11;arcSize=12;align=left;" vertex="1" parent="1">
                    <mxGeometry x="660" y="328" width="280" height="95" as="geometry"/>
                </mxCell>
                <!-- ============================================= -->
                <!-- STEP 3: Routing — 3 cases                     -->
                <!-- ============================================= -->
                <mxCell id="s3_label" value="③ Where does the command go?" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#f0a500;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="100" y="432" width="500" height="24" as="geometry"/>
                </mxCell>
                <!-- Case A: targeting self -->
                <mxCell id="case_a_bg" value="" style="rounded=1;fillColor=#1a2a0a;strokeColor=#4caf50;arcSize=10;" vertex="1" parent="1">
                    <mxGeometry x="100" y="462" width="320" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="case_a_t" value="CASE A — Targeting this node" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4caf50;fontSize=11;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="115" y="470" width="290" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="case_a" value="Command is for the GATT node itself.&lt;br&gt;Runs locally — no mesh hop needed.&lt;br&gt;Reply goes straight back to Pi 5." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#ccffcc;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="115" y="492" width="290" height="72" as="geometry"/>
                </mxCell>
                <!-- Case B: targeting one other node -->
                <mxCell id="case_b_bg" value="" style="rounded=1;fillColor=#1a1a3a;strokeColor=#e05c5c;arcSize=10;" vertex="1" parent="1">
                    <mxGeometry x="460" y="462" width="320" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="case_b_t" value="CASE B — Targeting a single node" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#e05c5c;fontSize=11;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="475" y="470" width="290" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="case_b" value="Command sent over BLE Mesh to that&lt;br&gt;specific node's unicast address.&lt;br&gt;That node runs it and replies via mesh." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#ffcccc;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="475" y="492" width="290" height="72" as="geometry"/>
                </mxCell>
                <!-- Case C: ALL nodes -->
                <mxCell id="case_c_bg" value="" style="rounded=1;fillColor=#2a1a0a;strokeColor=#f0a500;arcSize=10;" vertex="1" parent="1">
                    <mxGeometry x="820" y="462" width="340" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="case_c_t" value="CASE C — Targeting ALL nodes" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#f0a500;fontSize=11;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="835" y="470" width="310" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="case_c" value="GATT node runs command locally first,&lt;br&gt;then broadcasts to group 0xC000.&lt;br&gt;All other nodes run it too." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#ffdda0;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="835" y="492" width="310" height="72" as="geometry"/>
                </mxCell>
                <!-- Arrows: GATT node → 3 cases -->
                <mxCell id="e_ga" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="gatt_node" target="case_a_bg" parent="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_gb" value="BLE Mesh" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e05c5c;fontColor=#aaaaaa;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="gatt_node" target="case_b_bg" parent="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_gc" value="BLE Mesh broadcast" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f0a500;fontColor=#aaaaaa;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="gatt_node" target="case_c_bg" parent="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- ============================================= -->
                <!-- STEP 4: Node executes                         -->
                <!-- ============================================= -->
                <mxCell id="s4_label" value="④ The node executes the command" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4caf50;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="100" y="596" width="500" height="24" as="geometry"/>
                </mxCell>
                <!-- Command grid -->
                <!-- READ -->
                <mxCell id="cmd_read" value="&lt;b&gt;READ&lt;/b&gt;&lt;br&gt;No change to load.&lt;br&gt;Returns: voltage, current,&lt;br&gt;power, duty %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=11;arcSize=15;" vertex="1" parent="1">
                    <mxGeometry x="100" y="626" width="190" height="88" as="geometry"/>
                </mxCell>
                <!-- DUTY:50 / 50 -->
                <mxCell id="cmd_duty" value="&lt;b&gt;DUTY:50  or just  50&lt;/b&gt;&lt;br&gt;Sets brightness to 50%.&lt;br&gt;Returns sensor reading&lt;br&gt;at the new level." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=11;arcSize=15;" vertex="1" parent="1">
                    <mxGeometry x="305" y="626" width="190" height="88" as="geometry"/>
                </mxCell>
                <!-- STOP -->
                <mxCell id="cmd_stop" value="&lt;b&gt;STOP  /  0&lt;/b&gt;&lt;br&gt;Turns load fully OFF.&lt;br&gt;Returns sensor reading&lt;br&gt;(should read 0 A)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#e05c5c;fontColor=#ffcccc;fontSize=11;arcSize=15;" vertex="1" parent="1">
                    <mxGeometry x="510" y="626" width="190" height="88" as="geometry"/>
                </mxCell>
                <!-- 100 / ON -->
                <mxCell id="cmd_on" value="&lt;b&gt;100  /  ON&lt;/b&gt;&lt;br&gt;Turns load fully ON.&lt;br&gt;Returns sensor reading&lt;br&gt;at full brightness." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=11;arcSize=15;" vertex="1" parent="1">
                    <mxGeometry x="715" y="626" width="190" height="88" as="geometry"/>
                </mxCell>
                <!-- RAMP -->
                <mxCell id="cmd_ramp" value="&lt;b&gt;RAMP&lt;/b&gt;&lt;br&gt;Steps through duty levels:&lt;br&gt;0% → 25% → 50% → 75% → 100%&lt;br&gt;(500 ms each), then resets to 0%.&lt;br&gt;Returns final sensor reading." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a3a;strokeColor=#9c6fde;fontColor=#ddbbff;fontSize=11;arcSize=15;" vertex="1" parent="1">
                    <mxGeometry x="920" y="626" width="240" height="88" as="geometry"/>
                </mxCell>
                <!-- ============================================= -->
                <!-- STEP 5: Response back                         -->
                <!-- ============================================= -->
                <mxCell id="s5_label" value="⑤ Sensor data returns to Pi 5" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#4f9ede;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="100" y="736" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="resp" value="&lt;b&gt;Response format:&lt;/b&gt;  NODE1:DATA:D:50%,V:12.003V,I:500.00mA,P:6001.5mW&lt;br&gt;&lt;br&gt;Target node sends data back over BLE Mesh → GATT node receives → forwards to Pi 5 via BLE GATT notify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=12;arcSize=12;align=left;" vertex="1" parent="1">
                    <mxGeometry x="100" y="764" width="760" height="72" as="geometry"/>
                </mxCell>
                <!-- Arrows: commands → response -->
                <mxCell id="e_r1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" source="cmd_read" target="resp" parent="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_r2" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" source="cmd_duty" target="resp" parent="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_r3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e05c5c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="cmd_stop" target="resp" parent="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_r4" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4caf50;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" source="cmd_on" target="resp" parent="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_r5" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9c6fde;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" source="cmd_ramp" target="resp" parent="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Arrow: resp → pi5 (closes the loop) -->
                <mxCell id="e_back" value="back to Pi 5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4f9ede;fontColor=#aaaaaa;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" source="resp" target="pi5" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="60" y="800"/>
                            <mxPoint x="60" y="207"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <!-- ============================================= -->
                <!-- RIGHT SIDE PANEL: Notes                       -->
                <!-- ============================================= -->
                <!-- GATT node note box already placed above -->
                <!-- Fallback note -->
                <mxCell id="fallback_note" value="&lt;b&gt;⚠ Fallback mode&lt;/b&gt;&lt;br&gt;If the node isn't fully provisioned yet,&lt;br&gt;can only send basic ON/OFF.&lt;br&gt;No duty control, no sensor data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1a00;strokeColor=#f0a500;fontColor=#ffdda0;fontSize=11;arcSize=12;align=left;" vertex="1" parent="1">
                    <mxGeometry x="1220" y="626" width="270" height="88" as="geometry"/>
                </mxCell>
                <!-- Chunking note -->
                <mxCell id="chunk_note" value="&lt;b&gt;📦 Long responses are chunked&lt;/b&gt;&lt;br&gt;If the response is &gt;20 bytes,&lt;br&gt;it's split into pieces. Pi 5&lt;br&gt;reassembles them automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d1a2e;strokeColor=#4f9ede;fontColor=#aaaaee;fontSize=11;arcSize=12;align=left;" vertex="1" parent="1">
                    <mxGeometry x="1220" y="764" width="270" height="88" as="geometry"/>
                </mxCell>
                <!-- LEGEND -->
                <mxCell id="leg_bg" value="" style="rounded=1;fillColor=#141424;strokeColor=#333355;arcSize=8;" vertex="1" parent="1">
                    <mxGeometry x="100" y="870" width="900" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="l1" value="Pi 5 / GATT layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#4f9ede;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="115" y="884" width="155" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="l2" value="Node executes — ON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3a0d;strokeColor=#4caf50;fontColor=#ccffcc;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="280" y="884" width="155" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="l3" value="Node executes — OFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1010;strokeColor=#e05c5c;fontColor=#ffcccc;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="445" y="884" width="155" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="l4" value="Ramp sequence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a3a;strokeColor=#9c6fde;fontColor=#ddbbff;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="610" y="884" width="155" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="l5" value="Warnings / fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1a00;strokeColor=#f0a500;fontColor=#ffdda0;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="775" y="884" width="155" height="28" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>